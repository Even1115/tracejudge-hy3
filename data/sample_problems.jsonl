{"problem_id": "safe_mean", "title": "安全平均值 safe_mean", "requirement": "实现函数 safe_mean(nums)，计算数值列表的算术平均值。当输入为空列表时，必须直接返回 0.0，不能触发除以零错误；当输入非空时，返回其算术平均值 sum(nums) / len(nums)（浮点数）。", "function_signature": "def safe_mean(nums: list[float]) -> float:", "requirements": [{"requirement_id": "R1", "content": "输入为空列表时返回 0.0，不得抛出异常", "verification_hint": "safe_mean([]) == 0.0"}, {"requirement_id": "R2", "content": "输入非空时返回算术平均值 sum(nums) / len(nums)", "verification_hint": "safe_mean([1, 2, 3]) == 2.0"}], "visible_test_cases": [{"case_id": "v1", "args": [[1, 2, 3]], "kwargs": {}, "expected": 2.0, "category": "visible", "related_requirements": ["R2"]}, {"case_id": "v2", "args": [[10.0]], "kwargs": {}, "expected": 10.0, "category": "visible", "related_requirements": ["R2"]}], "hidden_test_cases": [{"case_id": "h1", "args": [[]], "kwargs": {}, "expected": 0.0, "category": "hidden", "related_requirements": ["R1"]}, {"case_id": "h2", "args": [[2, 4, 6, 8]], "kwargs": {}, "expected": 5.0, "category": "hidden", "related_requirements": ["R2"]}], "challenge_test_cases": [{"case_id": "c1", "args": [[]], "kwargs": {}, "expected": 0.0, "category": "challenge", "related_requirements": ["R1"]}, {"case_id": "c2", "args": [[-5, 5]], "kwargs": {}, "expected": 0.0, "category": "challenge", "related_requirements": ["R2"]}], "reference_code": "def safe_mean(nums: list[float]) -> float:\n    if not nums:\n        return 0.0\n    return sum(nums) / len(nums)\n", "difficulty": "easy", "source": "self_constructed_mvp_fixture", "tags": ["boundary", "arithmetic", "demo"]}
{"problem_id": "deduplicate_preserve_order", "title": "保序去重 deduplicate_preserve_order", "requirement": "实现函数 deduplicate_preserve_order(items)，返回一个去除重复元素、但保留每个元素首次出现顺序的新列表。列表元素均为可哈希类型。", "function_signature": "def deduplicate_preserve_order(items: list) -> list:", "requirements": [{"requirement_id": "R1", "content": "去除重复元素，只保留每个元素第一次出现的位置", "verification_hint": "deduplicate_preserve_order([1, 2, 1, 3, 2]) == [1, 2, 3]"}, {"requirement_id": "R2", "content": "空列表输入返回空列表", "verification_hint": "deduplicate_preserve_order([]) == []"}, {"requirement_id": "R3", "content": "元素互不相同时返回与输入顺序一致的新列表", "verification_hint": "deduplicate_preserve_order([1, 2, 3]) == [1, 2, 3]"}], "visible_test_cases": [{"case_id": "v1", "args": [[1, 2, 1, 3, 2]], "kwargs": {}, "expected": [1, 2, 3], "category": "visible", "related_requirements": ["R1"]}, {"case_id": "v2", "args": [[]], "kwargs": {}, "expected": [], "category": "visible", "related_requirements": ["R2"]}], "hidden_test_cases": [{"case_id": "h1", "args": [["a", "b", "a", "a", "c"]], "kwargs": {}, "expected": ["a", "b", "c"], "category": "hidden", "related_requirements": ["R1"]}, {"case_id": "h2", "args": [[5]], "kwargs": {}, "expected": [5], "category": "hidden", "related_requirements": ["R3"]}], "challenge_test_cases": [{"case_id": "c1", "args": [[1, 1, 1, 1]], "kwargs": {}, "expected": [1], "category": "challenge", "related_requirements": ["R1"]}, {"case_id": "c2", "args": [[1, 2, 3, 4]], "kwargs": {}, "expected": [1, 2, 3, 4], "category": "challenge", "related_requirements": ["R3"]}], "reference_code": "def deduplicate_preserve_order(items: list) -> list:\n    seen = set()\n    result = []\n    for item in items:\n        if item not in seen:\n            seen.add(item)\n            result.append(item)\n    return result\n", "difficulty": "medium", "source": "self_constructed_mvp_fixture", "tags": ["dedup", "order", "set"]}
{"problem_id": "clamp", "title": "区间限制 clamp", "requirement": "实现函数 clamp(value, low, high)，将数值 value 限制在闭区间 [low, high] 内：若 value 小于 low 返回 low；若 value 大于 high 返回 high；否则返回 value 本身。若 low > high（非法区间）则抛出 ValueError。", "function_signature": "def clamp(value: float, low: float, high: float) -> float:", "requirements": [{"requirement_id": "R1", "content": "value 小于 low 时返回 low", "verification_hint": "clamp(-5, 0, 10) == 0"}, {"requirement_id": "R2", "content": "value 大于 high 时返回 high", "verification_hint": "clamp(15, 0, 10) == 10"}, {"requirement_id": "R3", "content": "value 在 [low, high] 区间内（含边界）时返回 value 本身", "verification_hint": "clamp(5, 0, 10) == 5"}, {"requirement_id": "R4", "content": "当 low > high 时抛出 ValueError", "verification_hint": "clamp(5, 10, 0) 应抛出 ValueError"}], "visible_test_cases": [{"case_id": "v1", "args": [5, 0, 10], "kwargs": {}, "expected": 5, "category": "visible", "related_requirements": ["R3"]}, {"case_id": "v2", "args": [-5, 0, 10], "kwargs": {}, "expected": 0, "category": "visible", "related_requirements": ["R1"]}], "hidden_test_cases": [{"case_id": "h1", "args": [15, 0, 10], "kwargs": {}, "expected": 10, "category": "hidden", "related_requirements": ["R2"]}, {"case_id": "h2", "args": [0, 0, 10], "kwargs": {}, "expected": 0, "category": "hidden", "related_requirements": ["R3"]}, {"case_id": "h3", "args": [10, 0, 10], "kwargs": {}, "expected": 10, "category": "hidden", "related_requirements": ["R3"]}], "challenge_test_cases": [{"case_id": "c1", "args": [5, 10, 0], "kwargs": {}, "expected": {"raises": "ValueError"}, "category": "challenge", "related_requirements": ["R4"]}, {"case_id": "c2", "args": [-100, -50, 50], "kwargs": {}, "expected": -50, "category": "challenge", "related_requirements": ["R1"]}], "reference_code": "def clamp(value: float, low: float, high: float) -> float:\n    if low > high:\n        raise ValueError(\"low must not exceed high\")\n    if value < low:\n        return low\n    if value > high:\n        return high\n    return value\n", "difficulty": "easy", "source": "self_constructed_mvp_fixture", "tags": ["boundary", "range", "validation"]}
